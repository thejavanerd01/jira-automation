# Copy to .env and fill in. Never commit .env.

# Host only, no https://
JIRA_HOST=jira.yourcompany.com
JIRA_BEARER_TOKEN=paste-your-personal-access-token

# Only if Jira uses an internal certificate your Python doesn't trust
# JIRA_CA_BUNDLE=/path/to/corporate-ca.pem

# Custom field ids — find yours at https://<JIRA_HOST>/rest/api/2/field
STORY_POINTS_FIELD=customfield_10002
SPRINT_FIELD=customfield_10004

# Logging: DEBUG shows every JQL query and how each story was counted
LOG_LEVEL=INFO
# LOG_FILE=logs/squad-pulse.log     (default; set to none to log to the terminal only)
